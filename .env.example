# PostgreSQL connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/ghomz
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghomz"

# Used by Next.js for absolute URLs (optional in dev).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# NEXTAUTH_URL is optional in dev; set in production to the canonical URL.
# NEXTAUTH_URL="https://your-domain.com"
